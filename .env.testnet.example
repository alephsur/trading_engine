# Copy to .env.testnet (ignored). Use a dedicated funded TESTNET account/API wallet.
DATABASE_URL=postgres://trading:local_only@localhost:5433/trading
TESTNET_ACCOUNT=0x_REPLACE_WITH_MASTER_ACCOUNT_ADDRESS
# Absolute path outside the repository; file contains only the testnet API private key.
# On Linux: chmod 600 <file>
TESTNET_PRIVATE_KEY_FILE=/absolute/path/outside/repository/testnet-api.key
TESTNET_CONFIRM=TESTNET_ONLY
